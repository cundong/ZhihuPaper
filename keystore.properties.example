# Store this file outside the repository at:
#   ~/.config/zhihupaper/signing/keystore.properties
# Or point ZHIHUPAPER_KEYSTORE_PROPERTIES at another external file.
# Relative storeFile values are resolved from this properties file's directory.
storeFile=android.keystore
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=REPLACE_WITH_KEY_ALIAS
keyPassword=REPLACE_WITH_KEY_PASSWORD
