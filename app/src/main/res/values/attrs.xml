<?xml version="1.0" encoding="utf-8"?>
<!--
    Only the theme attributes the app actually reads are declared here.
    The original file carried ~180 attrs copied out of ActionBarSherlock and
    the Holo platform themes; almost all of them collided with AppCompat /
    Material Components declarations once the app moved to AndroidX.
-->
<resources>
    <attr name="listItemBackground" format="reference" />
    <attr name="listItemDefaultImage" format="reference" />
    <attr name="listItemTextNorColor" format="reference" />
    <attr name="listItemTextReadColor" format="reference" />
    <attr name="listItemDateTextColor" format="reference" />
    <attr name="listViewBackground" format="reference" />
    <attr name="webViewBackground" format="reference" />
</resources>
