<?xml version="1.0" encoding="utf-8"?>
<!--
    NewsDetailActivity. The toolbar floats over the article (the old code used
    Window.FEATURE_ACTION_BAR_OVERLAY plus a translucent background drawable),
    so the content sits underneath it inside a FrameLayout.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="80dp" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/ab_bg_black"
        android:theme="@style/Zhihu.ThemeOverlay.Toolbar.Transparent"
        app:popupTheme="@style/ThemeOverlay.Material3.Light" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/continuous_navigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:strokeColor="?attr/colorSurfaceVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="4dp"
            android:paddingRight="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/continuous_previous"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/continuous_previous"
                app:icon="@drawable/ic_continuous_previous"
                app:iconGravity="textStart" />

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:background="?attr/colorSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/continuous_next"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/continuous_next"
                app:icon="@drawable/ic_continuous_next"
                app:iconGravity="textEnd" />
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
