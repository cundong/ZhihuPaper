<?xml version="1.0" encoding="utf-8"?>
<!--
    News row with thumbnail. Uses MaterialCardView for the M3 elevated-card look
    instead of the hand-rolled 9-patch/shape "card_*" background.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/list_item_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorSurfaceVariant"
        app:cardBackgroundColor="?attr/colorSurface"
        app:rippleColor="?attr/colorPrimary">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="96dp"
            android:padding="12dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/list_item_image"
                android:layout_width="96dp"
                android:layout_height="72dp"
                android:layout_alignParentStart="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/Zhihu.ShapeAppearance.Thumbnail" />

            <TextView
                android:id="@+id/list_item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/list_item_image"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="2dp"
                android:maxLines="3"
                android:minLines="2"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?listItemTextNorColor"
                android:textIsSelectable="false"
                android:textSize="16sp" />
        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
